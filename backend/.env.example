# OpenAI API Key (or other AI provider)
OPENAI_API_KEY=your_api_key_here

# Server Configuration
PORT=8000
HOST=0.0.0.0

# Knowledge Base Path
# Local default: ../knowledgebase
# Railway: attach a Volume; the app will use RAILWAY_VOLUME_MOUNT_PATH automatically.
KNOWLEDGE_BASE_PATH=../knowledgebase
