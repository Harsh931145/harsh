# AI Provider API Keys (set at least ONE - priority: Meta > DeepSeek > xAI > Groq > OpenAI)
META_API_KEY=your_meta_api_key_here
META_MODEL=meta/muse-glimmer-30b
DEEPSEEK_API_KEY=your_deepseek_api_key_here
XAI_API_KEY=your_xai_api_key_here
XAI_MODEL=grok-2-vision-1212
GROQ_API_KEY=your_groq_api_key_here
OPENAI_API_KEY=your_api_key_here

# Server Configuration (Railway injects PORT automatically - do not override)
# PORT=8000
HOST=0.0.0.0

# Knowledge Base Path (default works when repo is deployed with root dir = backend)
KNOWLEDGE_BASE_PATH=../knowledgebase

